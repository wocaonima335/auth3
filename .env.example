AUTH_API_PORT=3000
AUTH_WEB_PORT=3010
AUTH_WORKER_POLL_MS=3000
AUTH_DEFAULT_USER=local-admin
AUTH_DATA_DIR=./data
AUTH_RUNTIME_MODE=compat-legacy-cli
AUTH_LEGACY_PROJECT_ROOT=E:/codex-registrar2/codex-registrar2_副本
AUTH_USERNAME_SOURCE=E:/codex-registrar2/codex-registrar2_副本/username.json
AUTH_LEGACY_TOKEN_DIRS=E:/codex-registrar2/codex-registrar2_副本/tokens
AUTH_LEGACY_CONFIG_PROFILE=server
AUTH_LEGACY_CONFIG_FILE=
AUTH_REDIS_ENABLED=true
AUTH_REDIS_URL=redis://127.0.0.1:6379/0
AUTH_REDIS_QUEUE_PENDING_KEY=auth:phase3:jobs:pending
AUTH_REDIS_QUEUE_PROCESSING_KEY=auth:phase3:jobs:processing
AUTH_REDIS_QUEUE_DEAD_KEY=auth:phase3:jobs:dead
AUTH_REDIS_BLOCKING_TIMEOUT_SEC=5
